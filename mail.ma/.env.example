# Tira Mail - local development environment template.
#
# This file is documentation, not configuration: the binary does not read
# `.env` files. Either export these variables yourself, or let
# `scripts/dev-local.ps1` set them for you (that script owns the values it
# needs to stay consistent with the ports it chose).
#
# Copy the lines you need into your shell:
#   PowerShell:  $env:TIRA_DEV_MODE = "1"
#   bash:        export TIRA_DEV_MODE=1
#
# Arabic walkthrough: docs/LOCAL-TESTING.md

# ---------------------------------------------------------------- storage
# The API refuses to start from a database whose name ends in _test/_tests,
# because the integration suite writes thousands of fixtures into those.
# `scripts/dev-local.ps1` creates and uses this one.
TIRA_DATABASE_URL=postgres://postgres@127.0.0.1:55432/tira_dev

# Content-addressed message bytes. Keep this separate from the directory used
# by any other database: the orphan sweep deletes blobs its own database does
# not reference.
TIRA_BLOB_ROOT=./data/blobs-dev

# ---------------------------------------------------------------- http
# Loopback only. A dev instance is not a public service.
TIRA_BIND=127.0.0.1:8080

# ---------------------------------------------------------------- dev signup
# TIRA_DEV_MODE=1 mounts GET/POST /signup. The route is additionally restricted
# to loopback peers, so a tunnel or a deployment cannot expose it even if this
# flag is left on. Never set it on a public host.
TIRA_DEV_MODE=1

# Every locally created mailbox joins the one tenant that owns this domain.
# `scripts/dev-local.ps1` creates it once (idempotently).
TIRA_DEV_DOMAIN=tira.test

# The session cookie is `Secure` by default, so a browser will not send it over
# plain HTTP. Local loopback testing opts out explicitly; never set this on a
# host reachable by anyone else.
TIRA_COOKIE_INSECURE=1

# ---------------------------------------------------------------- smtp loop
# The compose path submits to a relay. For local testing the relay is the
# bundled tira-smtp listener, so "send to yourself" is a real SMTP round trip.
TIRA_SMTP_ENABLE=1
TIRA_SMTP_ADDR=127.0.0.1:2525
TIRA_SMTP_HOST=127.0.0.1
TIRA_SMTP_PORT=2525

# Plaintext submission is allowed only for loopback hosts. Any remote relay
# must use STARTTLS: leave this unset (default 1) outside local testing.
TIRA_SMTP_STARTTLS=0

# ---------------------------------------------------------------- logging
RUST_LOG=info
